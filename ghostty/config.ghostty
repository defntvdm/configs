# Match the Kitty profile in ~/.config/kitty.

# Font
font-family = JetBrainsMono Nerd Font
font-size = 13

# Catppuccin Macchiato
theme = Catppuccin Macchiato
selection-foreground = #24273A
selection-background = #F4DBD6
palette = 0=#494D64
palette = 1=#ED8796
palette = 2=#A6DA95
palette = 3=#EED49F
palette = 4=#8AADF4
palette = 5=#F5BDE6
palette = 6=#8BD5CA
palette = 7=#B8C0E0
palette = 8=#5B6078
palette = 9=#ED8796
palette = 10=#A6DA95
palette = 11=#EED49F
palette = 12=#8AADF4
palette = 13=#F5BDE6
palette = 14=#8BD5CA
palette = 15=#A5ADCB

# Cursor
cursor-style = bar

# Scrollback and links
scrollback-limit = 10000000
scrollbar = never
link-url = true
link-previews = true

# Mouse and clipboard
copy-on-select = false
clipboard-trim-trailing-spaces = true

# Window and tabs
window-decoration = none
window-padding-x = 0
window-padding-y = 0
window-theme = ghostty
gtk-tabs-location = top
gtk-toolbar-style = flat
gtk-wide-tabs = false
unfocused-split-opacity = 1
split-divider-color = #B7BDF8

# Shell
command = /usr/bin/zsh

# Tabs
keybind = ctrl+1=goto_tab:1
keybind = ctrl+2=goto_tab:2
keybind = ctrl+3=goto_tab:3
keybind = ctrl+4=goto_tab:4
keybind = ctrl+5=goto_tab:5
keybind = ctrl+6=goto_tab:6
keybind = ctrl+7=goto_tab:7
keybind = ctrl+8=goto_tab:8
keybind = ctrl+9=goto_tab:9

# Clipboard
keybind = alt+c=copy_to_clipboard
keybind = alt+v=paste_from_clipboard

# Window and split management
keybind = ctrl+shift+enter=new_split:right
keybind = ctrl+shift+n=new_window
keybind = ctrl+shift+w=close_surface
keybind = ctrl+shift+right_bracket=goto_split:next
keybind = ctrl+shift+left_bracket=goto_split:previous
