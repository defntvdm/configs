{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": {
      "*": "allow",
      "~/.ssh/*": "deny",
      ".env": "deny",
    },
    "edit": "allow",
    "bash": {
      "*": "ask",
      "git *": "allow",
      "ls *": "allow",
      "uv *": "allow",
      "curl *": "allow",
    },
    "external_directory": "ask",
  },
  "plugin": [],
  "mode": {
    "build": {
      "model": "openai/gpt-5.6-terra",
      "options": {},
      "permission": {},
    },
    "plan": {
      "model": "openai/gpt-5.6-sol",
      "options": {},
      "permission": {},
    },
  },
  "provider": {
    "openai": {
      "options": {
        "headerTimeout": 60000,
        "timeout": 600000,
        "chunkTimeout": 60000,
      },
    },
  },
  "mcp": {
    "pencil": {
      "command": [
        "/Applications/Pen.app/Contents/Resources/app.asar.unpacked/out/mcp-server-darwin-arm64",
        "--app",
        "desktop",
        "--agent",
        "openCodeCLI",
      ],
      "enabled": false,
      "type": "local",
    },
  },
  "shell": "zsh",
}
