{
  "$schema": "https://opencode.ai/config.json",
  "mode": {
    "build": {
      "model": "openai/gpt-5.6-terra",
    },
    "plan": {
      "model": "openai/gpt-5.6-sol",
    },
  },
  "plugin": ["opencode-agent-skills", "opencode-snip"],
  "shell": "/bin/zsh",
  "disabled_providers": ["opencode"],
  "share": "disabled",
  "autoupdate": "notify",
  "snapshot": true,
  "permission": {
    "external_directory": {
      "*": "ask",
      "~/.ssh/*": "deny",
      ".env": "deny",
    },
    "read": {
      "*": "allow",
      "~/.ssh/*": "deny",
      ".env": "deny",
    },
    "edit": "allow",
    "bash": {
      "*": "ask",
      "git *": "allow",
      "hunk *": "allow",
    },
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "tail_turns": 4,
  },
}
